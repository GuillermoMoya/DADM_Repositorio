<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mapa OpenStreetMap a pantalla completa. -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Chip superior con el radio de búsqueda actual. -->
    <TextView
        android:id="@+id/radiusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/on_surface"
        android:textStyle="bold"
        android:elevation="4dp"
        tools:text="Radio: 2.0 km"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- Indicador de carga. -->
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Botón de ajustes (preferencias del radio y categorías). -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/action_settings"
        android:src="@drawable/ic_settings"
        app:fabSize="mini"
        app:tint="@color/on_primary" />

    <!-- Botón para volver a centrar en mi ubicación. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        android:contentDescription="@string/action_my_location"
        android:src="@drawable/ic_my_location"
        app:fabSize="mini"
        app:tint="@color/on_primary" />

    <!-- Botón principal: buscar puntos de interés cercanos. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/action_search"
        android:textColor="@color/on_primary"
        app:icon="@drawable/ic_search"
        app:iconTint="@color/on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
